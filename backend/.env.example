# Public URL of the web app. GitHub redirects back to {APP_URL}/api/auth/callback.
APP_URL=http://localhost:3000

# Create a GitHub OAuth app (GitHub → Settings → Developer settings → OAuth Apps → New)
# with that callback URL, then paste its credentials here.
GITHUB_CLIENT_ID=
GITHUB_CLIENT_SECRET=

# Long random string that encrypts session cookies, e.g. `openssl rand -base64 32`.
SESSION_SECRET=

# GitHub Enterprise Server only:
# GITHUB_WEB_URL=https://ghe.example.com
# GITHUB_API_URL=https://ghe.example.com/api/v3

CORS_ORIGINS=http://localhost:3000
CACHE_TTL_SECONDS=120
