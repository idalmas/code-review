# Public URL of the web app. GitHub redirects back to {APP_URL}/api/auth/callback.
APP_URL=http://localhost:3000

# Create a GitHub OAuth app (GitHub → Settings → Developer settings → OAuth Apps → New)
# with that callback URL, then paste its credentials here.
GITHUB_CLIENT_ID=
GITHUB_CLIENT_SECRET=

# Long random string that encrypts session cookies, e.g. `openssl rand -base64 32`.
SESSION_SECRET=

# GitHub Enterprise Server only:
# GITHUB_WEB_URL=https://ghe.example.com
# GITHUB_API_URL=https://ghe.example.com/api/v3

CORS_ORIGINS=http://localhost:3000
CACHE_TTL_SECONDS=120

# AI features (optional). Set one provider's key; with both, LLM_PROVIDER picks.
# Requests go straight from this server to the provider you choose, using your key.
ANTHROPIC_API_KEY=
OPENAI_API_KEY=
# LLM_PROVIDER=anthropic
# Override the model behind each tier (defaults: Anthropic Haiku 5.5 / Sonnet 5.5 / Opus 5.5,
# OpenAI gpt-6-luna / gpt-5.6-terra / gpt-6.1-sol).
# LLM_MODEL_CHEAP=
# LLM_MODEL_BALANCED=
# LLM_MODEL_BEST=

# Component renders and stress tests (optional): need Docker, an LLM key, and the sandbox
# image (docker build -t orbiter-sandbox sandbox-image).
# SANDBOX_ENABLED=true
# Install step only, for TLS-inspecting proxies (CA file = full bundle):
# SANDBOX_INSTALL_PROXY=
# SANDBOX_INSTALL_CA_FILE=
